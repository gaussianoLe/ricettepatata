---
import {href} from '../lib/urls';
import {photoFor} from '../../release/photos.mjs';
interface Props {slug:string;variant?:'hero'|'card'}
const {slug,variant='hero'}=Astro.props;
const photo=photoFor(slug);
---
{photo && <figure class={variant==='hero'?'release-photo':'release-photo-card'}><picture><source type="image/avif" srcset={[480,800,1280].map(w=>`${href(`media/${slug}-${w}.avif`)} ${w}w`).join(', ')} sizes={variant==='hero'?'(min-width:960px) 440px, 90vw':'(min-width:960px) 360px, 90vw'}/><source type="image/webp" srcset={[480,800,1280].map(w=>`${href(`media/${slug}-${w}.webp`)} ${w}w`).join(', ')} sizes={variant==='hero'?'(min-width:960px) 440px, 90vw':'(min-width:960px) 360px, 90vw'}/><img src={href(`media/${slug}-800.jpg`)} width={photo.width} height={photo.height} alt={photo.alt} loading={variant==='hero'?'eager':'lazy'} fetchpriority={variant==='hero'?'high':'auto'} decoding="async"/></picture>{variant==='hero' && <figcaption>{photo.caption} Foto: <a href={photo.sourcePage}>{photo.author}</a> · <a href={photo.licenseUrl}>{photo.license}</a>. Ridimensionata e convertita.</figcaption>}</figure>}
<style is:inline>.release-photo-card{margin:0;width:100%;height:100%}.release-photo-card img{width:100%;height:100%;object-fit:cover;display:block}.release-photo{margin:0;min-width:0}.release-photo img{display:block;width:100%;height:auto;border-radius:1rem}.release-photo figcaption{font: .78rem/1.6 system-ui,sans-serif;margin-top:.5rem;overflow-wrap:anywhere}.recipe-hero:has(.release-photo){grid-template-columns:minmax(0,1.2fr) minmax(0,1fr)}@media(max-width:759px){.recipe-hero:has(.release-photo){grid-template-columns:1fr}}</style>
