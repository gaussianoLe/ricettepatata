---
interface Props {sources:{id:string; title:string; url:string; author:string; accessedAt:string; kind:string}[]}
const {sources}=Astro.props;
---
{sources.length>0 && <section class="prose" aria-label="Fonti"><h2>Fonti e riferimenti</h2><ul>{sources.map(source=><li id={`fonte-${source.id}`}><a class="text-link" href={source.url} rel="noopener noreferrer">{source.title}</a> · {source.author} · Consultato il {source.accessedAt}{source.kind==='internal'?' · Documento interno, non prova di verifica editoriale':''}</li>)}</ul></section>}
