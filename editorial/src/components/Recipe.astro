---
import {formatIngredient} from '../../../src/catalog/view.mjs';
import {issues} from '../../data.mjs';
interface Props {record:import('astro/zod').z.infer<typeof import('../../../src/catalog/schema.mjs').recipeSchema>;label:string}
const {record,label}=Astro.props;
---
<section class="panel" data-editorial-record data-catalog-id={record.catalogId}><h2>{label}</h2><h3>{record.names.italian}</h3><p><span class="badge">{record.editorial.status}</span><strong>{record.demo?'DEMO':'RICETTA REALE'}</strong></p><dl><dt>UUID operativo</dt><dd><code>{record.catalogId}</code></dd><dt>Slug</dt><dd><code>{record.slug}</code></dd><dt>Nome originale</dt><dd lang={record.names.original.language}>{record.names.original.text}</dd><dt>Porzioni</dt><dd>{record.servings??'Non disponibili'}</dd><dt>Tempi</dt><dd>{record.timing?`Preparazione ${record.timing.prepMinutes} min · cottura ${record.timing.cookMinutes} min · riposo ${record.timing.restMinutes} min`:'Non quantificati: nessuna durata totale inventata'}</dd></dl><p>{record.description}</p><section class="issues"><h3>Dati mancanti e criticità</h3>{issues(record).length?<ul>{issues(record).map(issue=><li>{issue}</li>)}</ul>:<p>Nessun campo obbligatorio mancante; review editoriale comunque necessaria.</p>}</section><h3>Ingredienti e quantità</h3><ul>{record.ingredients.map(ingredient=><li>{formatIngredient(ingredient)}</li>)}</ul><h3>Procedimento</h3><ol>{record.steps.map(step=><li>{step.text}</li>)}</ol><h3>Fonti</h3><ul>{record.sources.map(source=><li><a href={source.url} target="_blank" rel="noreferrer noopener">{source.title}</a> · {source.author} · consultata {source.accessedAt} · {source.kind}</li>)}</ul>{record.notes.length>0 && <><h3>Note editoriali</h3><ul>{record.notes.map(note=><li>{note.text} <small>Fonti: {note.sourceIds.join(', ')}</small></li>)}</ul></>}</section>
