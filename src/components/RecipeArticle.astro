---
import Sources from './Sources.astro';
import EditorialNotes from './EditorialNotes.astro';
interface Props {
 record:import('astro/zod').z.infer<typeof import('../catalog/schema.mjs').recipeSchema>;
 presentation:ReturnType<typeof import('../../editorial/presentation.mjs').articlePresentation>;
 catalogHref:string;
 catalogLabel?:string;
 hasPhotograph?:boolean;
 related:{title:string;href:string}[];
}
const {record,presentation,catalogHref,related,catalogLabel='← Torna al catalogo locale'}=Astro.props;
const photograph=Astro.props.hasPhotograph??Astro.slots.has('photograph');

const origin=[record.provenance.region,record.provenance.country?.name].filter(Boolean).join(' · ');
---
<article class="recipe-article" data-recipe-article>
 <nav aria-label="Percorso della ricetta"><a href={catalogHref}>Ricette</a><span aria-hidden="true"> / </span><span aria-current="page">{record.names.italian}</span></nav>
 <header class="recipe-hero">
  <div><p class="eyebrow">Il mondo, una patata alla volta</p><h1>{record.names.italian}</h1><p class="original">Nome originale: <span lang={record.names.original.language}>{record.names.original.text}</span></p>
  <p class="intro">{presentation.intro}</p>{origin && <p class="origin">{origin}</p>}
  <dl class="facts">{record.servings!==null && <div><dt>Porzioni</dt><dd>{record.servings}</dd></div>}{record.timing && <><div><dt>Preparazione</dt><dd>{record.timing.prepMinutes} min</dd></div><div><dt>Cottura</dt><dd>{record.timing.cookMinutes} min</dd></div></>}</dl>
  {!record.timing && <p>Tempi non quantificati.</p>}
  </div>
  {photograph?<slot name="photograph"/>:<aside class="image-placeholder" aria-label="Stato della fotografia"><span class="placeholder-mark" aria-hidden="true">✳</span><p>Fotografia non disponibile.</p><small>Spazio riservato a una futura fotografia con licenza. Nessuna immagine del piatto è stata utilizzata.</small></aside>}
 </header>
 <nav class="recipe-jumps" aria-label="Consulta la ricetta"><a href="#ingredienti">Ingredienti</a><a href="#procedimento">Procedimento</a><a href="#approfondimenti">Note e fonti</a><button type="button" data-cooking-toggle aria-pressed="false" hidden>Modalità cucina</button></nav>
 <p class="cooking-help" data-cooking-help hidden>Spunta gli ingredienti mentre cucini. Le spunte restano solo in questa pagina e si azzerano ricaricandola. Lo schermo non viene mantenuto acceso.</p>
 <div class="cooking-grid">
  <section class="ingredient-panel" aria-labelledby="ingredienti"><p class="eyebrow">Sul piano di lavoro</p><h2 id="ingredienti" tabindex="-1">Ingredienti</h2><ul class="ingredient-list">{presentation.ingredients.map(ingredient=><li data-ingredient-id={ingredient.id}><label><input type="checkbox" data-ingredient-check/><span class="ingredient-copy"><span class="ingredient-main"><strong class="ingredient-amount">{ingredient.amount}</strong> <span class="ingredient-name">{ingredient.name}</span>{ingredient.optional && <span> (facoltativo)</span>}</span>{ingredient.detail && <small class="ingredient-detail">{ingredient.detail}</small>}</span></label></li>)}</ul>{presentation.cookingNotes.length>0 && <aside class="cooking-notes"><h3>Da tenere a mente</h3>{presentation.cookingNotes.map(text=><p>{text}</p>)}</aside>}</section>
  <section class="steps-panel" aria-labelledby="procedimento"><p class="eyebrow">Un passo alla volta</p><h2 id="procedimento" tabindex="-1">Procedimento</h2><ol class="steps-list" role="list">{record.steps.map((step,i)=><li><span class="step-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><p>{step.text}</p></li>)}</ol></section>
 </div>
 <div id="approfondimenti" class="supplements" tabindex="-1">{presentation.supplements.map(group=><section class={`supplement supplement-${group.id}`}><h2>{group.title}</h2>{group.paragraphs.map(text=>text.startsWith('- ')?<ul>{text.split('\n').map(line=><li>{line.replace(/^- /,'')}</li>)}</ul>:<p>{text}</p>)}</section>)}<div class="culture-notes"><EditorialNotes notes={record.notes}/></div><div class="source-notes"><Sources sources={record.sources}/></div></div>
 <nav class="related" aria-label="Altre ricette"><h2>Continua il viaggio</h2><a href={catalogHref}>{catalogLabel}</a>{related.map(item=><a href={item.href}>{item.title} →</a>)}</nav>
</article>
<script is:inline>
for(const article of document.querySelectorAll('[data-recipe-article]')){
 const button=article.querySelector('[data-cooking-toggle]');
 const help=article.querySelector('[data-cooking-help]');
 if(button){button.hidden=false;button.addEventListener('click',()=>{
  const active=button.getAttribute('aria-pressed')!=='true';
  button.setAttribute('aria-pressed',String(active));article.classList.toggle('cooking',active);if(help)help.hidden=!active;
 });}
}
</script>
<style is:inline>
.recipe-article{--ink:#25392e;--leaf:#28583b;--paper:#fffdf7;--line:#d8d8c4;--accent:#8f351b;color:var(--ink);font:1rem/1.7 system-ui,sans-serif;max-width:1200px;margin:auto;padding:1.2rem;overflow-wrap:anywhere}
.recipe-article a{text-decoration:underline;color:var(--leaf);text-underline-offset:.22em}.recipe-article :focus-visible{outline:3px solid var(--accent);outline-offset:4px}.recipe-article h1,.recipe-article h2{font-family:Georgia,serif;line-height:1.12;letter-spacing:-.025em}.recipe-article h1{font-size:clamp(2.35rem,5.5vw,4.6rem);margin:.65rem 0 .8rem;max-width:20ch}.recipe-article h2{font-size:clamp(1.6rem,3vw,2rem);margin:.5rem 0 1.2rem}.recipe-hero{display:grid;gap:1.3rem;padding:1.7rem 0}.eyebrow{font-size:.75rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:var(--accent);margin:.3rem 0 .7rem}.intro{font-size:clamp(1.1rem,2vw,1.3rem);line-height:1.6;max-width:55ch}.original{font-size:.9rem;margin:.4rem 0;color:#4b554d}.origin{font-size:.9rem;font-weight:700;margin:.8rem 0}.facts{display:flex;flex-wrap:wrap;gap:.7rem;margin:1.2rem 0 0}.facts>div{border-left:2px solid #b7c4ab;padding:.3rem 1rem .3rem .7rem}.facts dt{font-size:.8rem}.facts dd{margin:0;font-weight:800;font-size:1.2rem}.image-placeholder{background:#eeefdf;border:1px solid var(--line);border-radius:1rem;padding:1rem;display:grid;grid-template-columns:2rem 1fr;column-gap:.75rem;align-items:center}.placeholder-mark{font-size:2rem;line-height:1;color:var(--leaf);grid-row:span 2}.image-placeholder p{font-weight:700;font-size:.9rem;margin:0}.image-placeholder small{font-size:.8rem;line-height:1.5}.recipe-jumps{display:flex;flex-wrap:wrap;align-items:center;gap:.3rem;padding:.7rem 0;border-block:1px solid var(--line);background:var(--paper)}.recipe-jumps a,.recipe-jumps button{display:inline-flex;align-items:center;min-height:44px;padding:.65rem .75rem;font:inherit;font-size:.9rem;font-weight:700}.recipe-jumps button{color:var(--paper);background:var(--leaf);border:2px solid var(--leaf);border-radius:2rem;cursor:pointer}.recipe-jumps button[aria-pressed=true]{background:var(--ink);border-color:var(--accent)}.cooking-grid{display:grid;gap:2rem;margin:1.7rem 0 2.5rem}.ingredient-panel{background:#eeefdf;border:1px solid #d4d9c5;border-radius:1.2rem;padding:1.1rem;align-self:start;min-width:0}.ingredient-list{list-style:none;padding:0;margin:0}.ingredient-list li{border-bottom:1px solid #ccd2bd;padding:.75rem 0}.ingredient-list label{display:flex;gap:.75rem;align-items:flex-start;cursor:pointer;min-height:44px}.ingredient-list input{flex-shrink:0;margin:.25rem 0 0;width:1.35rem;height:1.35rem;accent-color:var(--leaf)}.ingredient-copy{display:block;min-width:0}.ingredient-main{display:block;line-height:1.6}.ingredient-amount{margin-right:.2em;font-weight:850;white-space:nowrap}.ingredient-name{font-size:1.02em}.ingredient-detail{display:block;color:#4b554d;font-size:.85rem;line-height:1.55;margin-top:.25rem}.ingredient-list input:checked+.ingredient-copy .ingredient-main{text-decoration:line-through}.ingredient-list input:checked+.ingredient-copy{color:#4b554d}.cooking-notes{border-left:3px solid var(--leaf);padding-left:.85rem;margin-top:1.2rem;font-size:.9rem}.cooking-notes h3{font-size:.85rem;margin:0}.cooking-notes p{margin:.25rem 0}.steps-panel{min-width:0}.steps-list{list-style:none;padding:0;margin:0;counter-reset:recipe-step}.steps-list li{display:grid;grid-template-columns:2.3rem minmax(0,1fr);gap:.9rem;padding:1.3rem 0;border-top:1px solid var(--line);break-inside:avoid}.step-number{display:flex;justify-content:center;align-items:center;align-self:start;background:#f2dfbe;color:#723114;border-radius:50%;width:2.3rem;height:2.3rem;font-weight:850;font-size:.9rem}.steps-list p{margin:0;max-width:57ch;line-height:1.85}.supplements{display:grid;gap:1rem;margin:2rem 0 2.5rem}.supplements h2{font-size:1.5rem}.supplement{padding:1.35rem;border:1px solid var(--line);border-radius:1rem;background:#fffdf7;min-width:0}.supplement-equipment{background:#f0eee1}.supplement-allergens{background:#fff2d9;border-left:4px solid #8f351b}.supplement-storage{border-left:4px solid var(--leaf)}.supplements p,.supplements li{max-width:68ch}.supplements p{margin:.5rem 0}.supplements li{margin-bottom:.6rem}.supplements ul{padding-left:1.2rem}.culture-notes{border-block:1px solid var(--line);padding:1rem .3rem}.source-notes{padding:1rem .3rem;font-size:.9rem}.source-notes li{margin-bottom:.9rem}.source-notes a{overflow-wrap:anywhere}.related{display:flex;flex-wrap:wrap;gap:.75rem;border-top:2px solid var(--leaf);padding:1.3rem 0}.related h2{flex-basis:100%;margin-bottom:.3rem}.related a{display:inline-flex;align-items:center;min-height:44px;padding:.4rem .6rem}.cooking .cooking-grid{font-size:1.15rem;line-height:1.9}.cooking .ingredient-panel{border:2px solid var(--leaf)}.cooking .steps-list li{border-top:2px solid #b5c3ad}.cooking .step-number{background:var(--leaf);color:var(--paper)}.cooking-help{padding:.9rem;background:#eeefdf;border-left:4px solid var(--leaf);font-size:.9rem;max-width:75ch}[hidden]{display:none!important}
@media(min-width:760px){.recipe-article{padding:1.5rem 2rem}.recipe-hero{grid-template-columns:minmax(0,1fr) 220px;align-items:center;gap:2rem}.image-placeholder{grid-template-columns:1fr;text-align:center;padding:1.25rem;gap:.7rem}.placeholder-mark{grid-row:auto;font-size:2.7rem}.supplements{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.3rem}.supplement-equipment,.source-notes,.culture-notes{grid-column:1/-1}.supplement-equipment ul{display:flex;flex-wrap:wrap;gap:.5rem 2.5rem}.recipe-jumps{gap:.6rem}}
@media(min-width:960px){.cooking-grid{grid-template-columns:minmax(0,.9fr) minmax(0,1.45fr);gap:2.5rem}.ingredient-panel{padding:1.35rem}.recipe-hero{padding:2rem 0}.cooking .cooking-grid{gap:2rem}}
@media print{.recipe-jumps button,.ingredient-list input,.related{display:none}.recipe-article{font-size:11pt}.image-placeholder{display:none}.recipe-hero,.cooking-grid,.supplements{display:block}.supplement{margin:1rem 0}.steps-list li{break-inside:avoid}}
</style>
