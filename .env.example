# Il target si sceglie con npm run build / npm run build:preview, indipendentemente da BASE_PATH.
# Solo per sviluppo locale HTTP: BUILD_TARGET=preview SITE_URL=http://localhost:4321 npm run dev
# Omettere BASE_PATH per i default dei due target.
