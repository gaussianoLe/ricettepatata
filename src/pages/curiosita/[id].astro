---
import {visibleCollection} from '../../catalog/collections';
import {render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EditorialNotes from '../../components/EditorialNotes.astro';
import Sources from '../../components/Sources.astro';
import {href} from '../../lib/urls';
export async function getStaticPaths(){return (await visibleCollection('curiosita')).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props; const {Content}=await render(entry);
const schema={'@context':'https://schema.org','@type':'Article',headline:entry.data.names.italian,description:entry.data.description,...(entry.data.editorial.publishedAt?{datePublished:entry.data.editorial.publishedAt}:{}),author:{'@type':'Organization',name:entry.data.editorial.author},mainEntityOfPage:new URL(href(`curiosita/${entry.id}/`),Astro.site).href};
---
<Layout title={entry.data.names.italian} description={entry.data.description} schema={schema}><article class="section wrap article"><a class="text-link" href={href('curiosita/')}>← Curiosità</a><p class="eyebrow">Curiosità</p><h1>{entry.data.names.italian}</h1><p class="lead">{entry.data.description}</p>{entry.data.editorial.status!=='published' && <p class="demo-label">Contenuto in lavorazione · Da revisionare dalla redazione</p>}<div class="prose"><Content/></div><EditorialNotes notes={entry.data.notes}/><Sources sources={entry.data.sources}/></article></Layout>
