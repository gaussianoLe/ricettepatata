---
import {render} from 'astro:content';
import {visibleCollection} from '../../catalog/collections';
import {recipeView} from '../../catalog/view.mjs';
import Layout from '../../layouts/Layout.astro';
import PotatoArt from '../../components/PotatoArt.astro';
import EditorialNotes from '../../components/EditorialNotes.astro';
import Sources from '../../components/Sources.astro';
import {href} from '../../lib/urls';
export async function getStaticPaths(){
 const recipes=await visibleCollection('ricette');
 const routes=new Map(recipes.map(recipe=>[recipe.data.catalogId,recipe.id]));
 return recipes.map(recipe=>({params:{id:recipe.id},props:{recipe,primarySlug:recipe.data.relation.kind==='variant'?routes.get(recipe.data.relation.primaryId):undefined}}));
}
const {recipe,primarySlug}=Astro.props;const raw=recipe.data;const d=recipeView(raw);const {Content}=await render(recipe);
const schema={'@context':'https://schema.org','@type':'Recipe',name:d.title,alternateName:raw.names.alternatives.map(name=>name.text),description:d.description,...(raw.editorial.publishedAt?{datePublished:raw.editorial.publishedAt}:{}),author:{'@type':'Organization',name:raw.editorial.author},recipeCuisine:d.country,recipeCategory:raw.taxonomy.courses.join(', '),prepTime:`PT${d.prep}M`,cookTime:`PT${d.cook}M`,totalTime:`PT${d.total}M`,recipeYield:`${d.servings} porzioni`,recipeIngredient:d.ingredients,recipeInstructions:d.steps.map(text=>({'@type':'HowToStep',text})),citation:raw.sources.map(source=>source.url),url:new URL(href(`ricette/${recipe.id}/`),Astro.site).href,inLanguage:'it-IT'};
---
<Layout title={d.title} description={d.description} schema={schema}><article class="wrap recipe-detail section"><a class="text-link" href={href('ricette/')}>← Tutte le ricette</a><div class="detail-header"><div><p class="eyebrow">{d.country} · Il ricettario</p><h1>{d.title}</h1>{raw.names.original.text!==d.title && <p lang={raw.names.original.language}>{raw.names.original.text}</p>}<p class="lead">{d.description}</p><p>Preparazione {d.prep} min · Cottura {d.cook} min{d.rest>0?` · Riposo ${d.rest} min`:''} · {d.servings} porzioni</p>{raw.editorial.status!=='published' && <p class="demo-label">Ricetta in lavorazione · Da revisionare dalla redazione</p>}{primarySlug && <p>Variante regionale di <a class="text-link" href={href(`ricette/${primarySlug}/`)}>questa ricetta principale</a>.</p>}</div><div class:list={['card-art',d.color]}><PotatoArt/></div></div><div class="recipe-body"><section><h2>Ingredienti</h2><ul>{d.ingredients.map(item=><li>{item}</li>)}</ul></section><section><h2>Mettiamoci ai fornelli</h2><ol>{d.steps.map(step=><li>{step}</li>)}</ol><div class="prose"><Content/></div><EditorialNotes notes={raw.notes}/><Sources sources={raw.sources}/></section></div></article></Layout>
