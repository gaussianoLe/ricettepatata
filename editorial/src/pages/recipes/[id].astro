---
import Shell from '../../components/Shell.astro';
import Recipe from '../../components/Recipe.astro';
import {editorialData} from '../../../data.mjs';
export const prerender=false;
const {catalog,proposals}=editorialData();
const entry=catalog.find(e=>e.data.catalogId===Astro.params.id);
if(!entry)return Astro.redirect('/404');
const proposal=proposals.find(p=>p.plan.catalogId===entry.data.catalogId);
---
<Shell title={entry.data.names.italian}><a href="/">← Catalogo locale</a>{proposal && <p><a href={`/enrichments/${proposal.plan.researchId}/`}>Confronta la proposta non applicata</a></p>}{entry.validation && <section class="notice"><h2>Validazione gastronomica P1.8: {entry.validation.outcome}</h2><p>Esito documentale, non approvazione o promozione del catalogo.</p><ul>{entry.validation.essentialIssues.map(issue=><li>{issue}</li>)}</ul><ul>{entry.validation.openIssues.map(issue=><li>{issue}</li>)}</ul></section>}<Recipe record={entry.data} label="Contenuto operativo attuale"/><details><summary>Corpo Markdown sorgente · sola lettura</summary><pre>{entry.body}</pre></details></Shell>
