---
import Shell from '../../components/Shell.astro';
import Recipe from '../../components/Recipe.astro';
import {editorialData} from '../../../data.mjs';
export const prerender=false;
const {catalog,proposals}=editorialData();
const entry=catalog.find(e=>e.data.catalogId===Astro.params.id);
if(!entry)return Astro.redirect('/404');
const proposal=proposals.find(p=>p.plan.catalogId===entry.data.catalogId);
---
<Shell title={entry.data.names.italian}><a href="/">← Catalogo locale</a>{proposal && <p><a href={`/enrichments/${proposal.plan.researchId}/`}>Confronta la proposta non applicata</a></p>}{entry.resolution && <section class="notice"><h2>Risoluzione editoriale P1.9: {entry.resolution.outcome}</h2><p>Seconda revisione documentale; nessuna modifica o approvazione operativa.</p><ul>{entry.resolution.essentialIssues.map(issue=><li>{issue}</li>)}</ul>{entry.data.slug==='gratin-dauphinois' && <a href="/resolution/RP-0062/">Esamina la proposta alternativa P1.9, non applicata</a>}</section>}{entry.validation && <section class="notice"><h2>Validazione gastronomica P1.8: {entry.validation.outcome}</h2><p>Esito documentale, non approvazione o promozione del catalogo.</p><ul>{entry.validation.essentialIssues.map(issue=><li>{issue}</li>)}</ul><ul>{entry.validation.openIssues.map(issue=><li>{issue}</li>)}</ul></section>}<Recipe record={entry.data} label="Contenuto operativo attuale"/><details><summary>Corpo Markdown sorgente · sola lettura</summary><pre>{entry.body}</pre></details></Shell>
